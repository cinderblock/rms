{
  "name": "remote-mgmt-daemon",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "tray:dev": "bun run --cwd apps/tray dev",
    "tray:build": "bun run --cwd apps/tray build",
    "fmt": "cargo fmt --all",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "cargo fmt --all -- --check && bun run lint"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0"
  },
  "packageManager": "bun@1.3.0"
}
